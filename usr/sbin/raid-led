#!/bin/sh

LED="/sys/class/leds/red:status"
MD="/sys/block/md0/md"

mode=""

set_mode() {
    new_mode="$1"

    [ "$new_mode" = "$mode" ] && return

    case "$new_mode" in
        off)
            echo none > "$LED/trigger"
            echo 0 > "$LED/brightness"
            ;;
        on)
            echo none > "$LED/trigger"
            echo 1 > "$LED/brightness"
            ;;
        blink)
            echo timer > "$LED/trigger"
            echo 500 > "$LED/delay_on"
            echo 500 > "$LED/delay_off"
            ;;
    esac

    mode="$new_mode"
}

while :; do
    action=$(cat "$MD/sync_action" 2>/dev/null)
    degraded=$(cat "$MD/degraded" 2>/dev/null)

    case "$action" in
        recover|resync|repair|reshape)
            set_mode blink
            ;;
        *)
            if [ "$degraded" = "1" ]; then
                set_mode on
            else
                set_mode off
            fi
            ;;
    esac

    sleep 5
done
